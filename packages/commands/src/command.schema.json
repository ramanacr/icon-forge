{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/CommandEnvelopeV1",
  "$defs": {
    "CommandEnvelopeV1": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectCommand"
        },
        {
          "$ref": "#/$defs/HistoryCommand"
        }
      ]
    },
    "ProjectCommand": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "project.create"
            },
            "payload": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/UUID"
                },
                "name": {
                  "type": "string"
                },
                "designSystem": {
                  "$ref": "#/$defs/DesignSystemV1"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "commandVersion": {
              "type": "string",
              "const": "1.0"
            },
            "commandId": {
              "$ref": "#/$defs/UUID"
            },
            "projectId": {
              "$ref": "#/$defs/UUID"
            },
            "expectedRevision": {
              "type": "number"
            },
            "dryRun": {
              "type": "boolean"
            },
            "confirmsDryRun": {
              "$ref": "#/$defs/UUID"
            },
            "issuedAt": {
              "type": "string"
            },
            "actor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "cli",
                    "mcp",
                    "webmcp",
                    "ai-proposal"
                  ]
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "actor",
            "commandId",
            "commandVersion",
            "issuedAt",
            "payload",
            "projectId",
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "project.rename"
            },
            "payload": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "commandVersion": {
              "type": "string",
              "const": "1.0"
            },
            "commandId": {
              "$ref": "#/$defs/UUID"
            },
            "projectId": {
              "$ref": "#/$defs/UUID"
            },
            "expectedRevision": {
              "type": "number"
            },
            "dryRun": {
              "type": "boolean"
            },
            "confirmsDryRun": {
              "$ref": "#/$defs/UUID"
            },
            "issuedAt": {
              "type": "string"
            },
            "actor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "cli",
                    "mcp",
                    "webmcp",
                    "ai-proposal"
                  ]
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "actor",
            "commandId",
            "commandVersion",
            "issuedAt",
            "payload",
            "projectId",
            "type"
          ]
        }
      ]
    },
    "UUID": {
      "type": "string",
      "description": "Persisted v1 document types. SCHEMAS.md is the normative contract."
    },
    "DesignSystemV1": {
      "type": "object",
      "properties": {
        "grid": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "safeArea": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ],
          "additionalProperties": false
        },
        "style": {
          "type": "string",
          "enum": [
            "outline",
            "filled",
            "duotone",
            "custom"
          ]
        },
        "stroke": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number"
            },
            "cap": {
              "$ref": "#/$defs/LineCap"
            },
            "join": {
              "$ref": "#/$defs/LineJoin"
            },
            "miterLimit": {
              "type": "number"
            }
          },
          "required": [
            "width",
            "cap",
            "join",
            "miterLimit"
          ],
          "additionalProperties": false
        },
        "cornerRadius": {
          "type": "number"
        },
        "defaultPaintToken": {
          "type": "string"
        },
        "naming": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "const": "kebab"
            },
            "reserved": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "pattern",
            "reserved"
          ],
          "additionalProperties": false
        },
        "severities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Severity"
          }
        }
      },
      "required": [
        "grid",
        "safeArea",
        "style",
        "stroke",
        "cornerRadius",
        "defaultPaintToken",
        "naming",
        "severities"
      ],
      "additionalProperties": false
    },
    "LineCap": {
      "type": "string",
      "enum": [
        "butt",
        "round",
        "square"
      ]
    },
    "LineJoin": {
      "type": "string",
      "enum": [
        "miter",
        "round",
        "bevel"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "off",
        "info",
        "warning",
        "error"
      ]
    },
    "HistoryCommand": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "history.undo"
            },
            "payload": {
              "type": "object",
              "additionalProperties": {
                "not": {}
              }
            },
            "commandVersion": {
              "type": "string",
              "const": "1.0"
            },
            "commandId": {
              "$ref": "#/$defs/UUID"
            },
            "projectId": {
              "$ref": "#/$defs/UUID"
            },
            "expectedRevision": {
              "type": "number"
            },
            "dryRun": {
              "type": "boolean"
            },
            "confirmsDryRun": {
              "$ref": "#/$defs/UUID"
            },
            "issuedAt": {
              "type": "string"
            },
            "actor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "cli",
                    "mcp",
                    "webmcp",
                    "ai-proposal"
                  ]
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "actor",
            "commandId",
            "commandVersion",
            "issuedAt",
            "payload",
            "projectId",
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "history.redo"
            },
            "payload": {
              "type": "object",
              "additionalProperties": {
                "not": {}
              }
            },
            "commandVersion": {
              "type": "string",
              "const": "1.0"
            },
            "commandId": {
              "$ref": "#/$defs/UUID"
            },
            "projectId": {
              "$ref": "#/$defs/UUID"
            },
            "expectedRevision": {
              "type": "number"
            },
            "dryRun": {
              "type": "boolean"
            },
            "confirmsDryRun": {
              "$ref": "#/$defs/UUID"
            },
            "issuedAt": {
              "type": "string"
            },
            "actor": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "cli",
                    "mcp",
                    "webmcp",
                    "ai-proposal"
                  ]
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "actor",
            "commandId",
            "commandVersion",
            "issuedAt",
            "payload",
            "projectId",
            "type"
          ]
        }
      ]
    }
  }
}
